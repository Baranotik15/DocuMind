# Copy to .env and adjust as needed for local docker-compose use.

# Async driver (asyncpg) — used by the FastAPI backend
DATABASE_URL=postgresql+asyncpg://documind:documind@postgres:5432/documind

# Sync driver (psycopg) — used by the Celery worker and Alembic
DATABASE_URL_SYNC=postgresql+psycopg://documind:documind@postgres:5432/documind

CELERY_BROKER_URL=redis://redis:6379/0
