# Copy to .env and adjust as needed for local docker-compose use.

# Async driver (asyncpg) — used by the FastAPI backend
DATABASE_URL=postgresql+asyncpg://documind:documind@postgres:5432/documind

# Sync driver (psycopg) — used by the Celery worker and Alembic
DATABASE_URL_SYNC=postgresql+psycopg://documind:documind@postgres:5432/documind

CELERY_BROKER_URL=redis://redis:6379/0

# OpenAI API key — used by the backend for embeddings and chat completion.
# Required for real chunking (parse/chunk/embed) and chat to work; without
# it, documents fail during chunking and chat replies with a 502 - both
# gracefully, but nothing actually calls OpenAI.
OPENAI_API_KEY=

# OpenAI Admin API key — separate from OPENAI_API_KEY above, NOT a
# replacement for it. A regular/project key (like OPENAI_API_KEY) cannot
# read organization usage/billing data; an Admin key can, but can't make
# completions/embeddings calls itself, so the app needs both. Create one at
# platform.openai.com under Organization settings -> Admin keys (requires
# Owner/Admin role) - scope it "Read only". Starts with `sk-admin-`.
# Optional: only needed for the dashboard's usage/budget display; without
# it, that panel just has nothing to show.
OPENAI_ADMIN_API_KEY=

# Optional overrides - defaults live in backend/app/config.py, uncomment
# only if you need something other than the default.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# CHAT_RETRIEVAL_TOP_K=5

# Where uploaded documents are stored (inside the backend/worker containers,
# shared via the `documind_storage` docker-compose volume). Rarely needs
# to change for local use.
# STORAGE_BASE_DIR=./data/documents
